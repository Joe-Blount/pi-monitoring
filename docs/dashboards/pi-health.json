[
  {
    "apiVersion": "influxdata.com/v2alpha1",
    "kind": "Dashboard",
    "metadata": {
      "name": "pi-health"
    },
    "spec": {
      "name": "Pi health",
      "description": "Every machine that reports host readings, found by its readings.",
      "charts": [
        {
          "name": "Machines",
          "xPos": 0,
          "yPos": 0,
          "width": 12,
          "height": 3,
          "kind": "Table",
          "queries": [
            {
              "query": "// One row per machine that has reported in the last week, newest readings.\n// A machine that stops reporting stays listed, and \"seen\" says how long ago.\n\nimport \"math\"\n\n// Strings and numbers are read apart: one stream holding both is a type\n// conflict for every function that touches _value.\nrecent = (fields) =>\n    from(bucket: \"raw\")\n        |> range(start: -7d)\n        |> filter(fn: (r) => contains(value: r._field, set: fields))\n        |> last()\n\nlatest = recent(\n    fields: [\n        \"uptime_seconds\",\n        \"cpu_temp_f\",\n        \"load_per_core\",\n        \"mem_used_pct\",\n        \"swap_used_pct\",\n        \"root_used_pct\",\n        \"code_dirty\",\n        \"code_installed_time\",\n    ],\n)\n\nago = (t) => string(v: duration(v: (int(v: now()) - int(v: t)) / 1000000000 * 1000000000))\n\nseen = latest\n    |> filter(fn: (r) => r._field == \"uptime_seconds\")\n    |> map(fn: (r) => ({r with _field: \"seen\", _value: ago(t: r._time) + \" ago\"}))\n\nuptime = latest\n    |> filter(fn: (r) => r._field == \"uptime_seconds\")\n    |> map(fn: (r) => ({r with _field: \"up\", _value: string(v: duration(v: int(v: r._value) * 1000000000))}))\n\nnumbers = latest\n    |> filter(\n        fn: (r) =>\n            r._field == \"cpu_temp_f\" or r._field == \"load_per_core\" or r._field == \"mem_used_pct\"\n                or\n                r._field == \"swap_used_pct\" or r._field == \"root_used_pct\",\n    )\n    |> map(fn: (r) => ({r with _value: string(v: math.round(x: r._value * 100.0) / 100.0)}))\n\ntext = recent(fields: [\"ip\", \"code_commit\", \"code_branch\"])\n\ndirty = latest\n    |> filter(fn: (r) => r._field == \"code_dirty\")\n    |> map(fn: (r) => ({r with _value: if r._value > 0.5 then \"local changes\" else \"clean\"}))\n\ninstalled = latest\n    |> filter(fn: (r) => r._field == \"code_installed_time\")\n    |> map(\n        fn: (r) =>\n            ({r with _value: ago(t: time(v: int(v: r._value) * 1000000000)) + \" ago\"}),\n    )\n\nunion(tables: [seen, uptime, numbers, text, dirty, installed])\n    |> group(columns: [\"_measurement\", \"node\"])\n    |> pivot(rowKey: [\"_measurement\", \"node\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n    |> group()\n    |> rename(columns: {_measurement: \"site\"})\n    |> sort(columns: [\"site\", \"node\"])\n"
            }
          ],
          "timeFormat": "",
          "decimalPlaces": 0,
          "enforceDecimals": true,
          "colors": [
            {
              "name": "laser",
              "type": "text",
              "hex": "#00C9FF"
            }
          ],
          "tableOptions": {
            "verticalTimeAxis": true,
            "wrapping": "truncate",
            "fixFirstColumn": true,
            "sortBy": "site"
          },
          "fieldOptions": [
            {
              "fieldName": "site",
              "displayName": "site",
              "visible": true
            },
            {
              "fieldName": "node",
              "displayName": "node",
              "visible": true
            },
            {
              "fieldName": "seen",
              "displayName": "seen",
              "visible": true
            },
            {
              "fieldName": "up",
              "displayName": "up",
              "visible": true
            },
            {
              "fieldName": "ip",
              "displayName": "address",
              "visible": true
            },
            {
              "fieldName": "cpu_temp_f",
              "displayName": "CPU F",
              "visible": true
            },
            {
              "fieldName": "load_per_core",
              "displayName": "load/core",
              "visible": true
            },
            {
              "fieldName": "mem_used_pct",
              "displayName": "mem %",
              "visible": true
            },
            {
              "fieldName": "swap_used_pct",
              "displayName": "swap %",
              "visible": true
            },
            {
              "fieldName": "root_used_pct",
              "displayName": "disk %",
              "visible": true
            },
            {
              "fieldName": "code_commit",
              "displayName": "commit",
              "visible": true
            },
            {
              "fieldName": "code_branch",
              "displayName": "branch",
              "visible": true
            },
            {
              "fieldName": "code_dirty",
              "displayName": "checkout",
              "visible": true
            },
            {
              "fieldName": "code_installed_time",
              "displayName": "installed",
              "visible": true
            }
          ]
        },
        {
          "name": "CPU temperature",
          "xPos": 0,
          "yPos": 3,
          "width": 6,
          "height": 3,
          "kind": "Xy",
          "queries": [
            {
              "query": "from(bucket: \"raw\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._field == \"cpu_temp_f\")\n    |> group(columns: [\"_measurement\", \"node\"])\n    |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n"
            }
          ],
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "position": "overlaid",
          "colors": [
