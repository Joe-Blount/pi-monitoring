            {
              "query": "import \"date\"\nimport \"timezone\"\n\noption location = timezone.location(name: \"America/Chicago\")\n\nfrom(bucket: \"raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"blind1\")\n  |> filter(fn: (r) => r[\"_field\"] == \"yield_today_kwh\")\n  |> filter(fn: (r) => r[\"location\"] == \"solar\")\n  |> aggregateWindow(every: 1d, fn: last, offset: 22h, createEmpty: false)\n  |> map(fn: (r) => ({\n      r with\n      _time: date.truncate(t: r._time, unit: 1d)\n  }))\n  |> drop(columns: [\"_start\", \"_stop\", \"_field\", \"_measurement\", \"location\"])\n  |> yield(name: \"daily_yield\")"
