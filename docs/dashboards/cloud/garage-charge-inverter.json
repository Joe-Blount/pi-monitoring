          "xPos": 0,
          "yPos": 0,
          "width": 4,
          "height": 4,
          "kind": "Xy",
          "queries": [
            {
              "query": "from(bucket: \"raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"garage\")\n  |> filter(fn: (r) => r[\"device\"] == \"inverter\")\n  |> filter(fn: (r) => r[\"_field\"] == \"ac_out_hz\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
            }
