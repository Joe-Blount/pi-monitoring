#!/usr/bin/env python3
"""Serve the page that forces this node's loads on or off.

    control-page --node <file>                  under systemd: the socket
                                                 it was handed
    control-page --node <file> --listen ADDR:PORT  by hand

It exits after two minutes with no request. Under systemd the socket unit
then listens again, so the next visit starts it afresh.
"""

import argparse
import os
import sys

# realpath, for the same reason bin/control gives: a symlink on the command
# search path must not move the package root.
sys.path.insert(
    0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from monitoring.control import page  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(prog="control-page", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--node", default=os.environ.get(
        "MONITORING_NODE", "/etc/monitoring/node.yaml"))
    parser.add_argument("--listen", metavar="ADDR:PORT",
                        help="bind here instead of using a socket from "
                             "systemd")
    args = parser.parse_args(argv)

    paths = page.Paths(
        args.node,
        switches=os.environ.get("MONITORING_SWITCHES"),
        published=os.environ.get("MONITORING_PUBLISHED"),
        readings=os.environ.get("MONITORING_READINGS"),
        boot=os.environ.get("MONITORING_BOOT_ID"))
    listening = page.inherited_socket()
    if listening is None:
        if not args.listen:
            parser.error("no socket from systemd; give --listen ADDR:PORT")
        host, _, port = args.listen.rpartition(":")
        address = (host or "127.0.0.1", int(port))
    else:
        address = None
    server = page.Server(address, page.handler_for(paths), listening)
    try:
        server.serve_until_idle()
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
