# Copy to /etc/monitoring/influx.env on each node, mode 600, owned by root.
# The token is the only secret here; the rest is public configuration.
#
# Install it without the value ever reaching a command line or shell history:
#
#   read -s -p "paste write token: " T; echo
#   T="${T//[[:space:]]/}"
#   { printf 'INFLUX_HOST=%s\n'      'https://REGION.aws.cloud2.influxdata.com'
#     printf 'INFLUX_ORG=%s\n'       'your-org'
#     printf 'INFLUX_BUCKET=%s\n'    'your-bucket'
#     printf 'INFLUX_TOKEN=%s\n'     "$T"; } | sudo tee /etc/monitoring/influx.env >/dev/null
#   sudo chmod 600 /etc/monitoring/influx.env
#   sudo chown root:root /etc/monitoring/influx.env
#   unset T
#
# The token needs WRITE on the bucket and nothing else. Nothing in this
# project reads from InfluxDB.
#
# Note the bucket is addressed by name here. If a grant fails with 403, check
# that the token was granted on the bucket's real name rather than on the
# measurement name, which is a different thing and an easy mistake.

INFLUX_HOST=https://REGION.aws.cloud2.influxdata.com
INFLUX_ORG=your-org
INFLUX_BUCKET=your-bucket
INFLUX_TOKEN=paste-a-write-only-token-here
